<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_bg"
    tools:context=".PlayerActivity">

    <ImageView
        android:id="@+id/imageViewGredient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/gredient_bg" />

    <RelativeLayout
        android:id="@+id/layout_top_btn"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:layout_alignParentTop="true"
        android:background="@drawable/gredient_for_top_bg">

        <ImageView
            android:id="@+id/back_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="15dp"
            android:src="@drawable/ic_baseline_chevron_left" />

        <ImageView
            android:id="@+id/playback_speed_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/outline_fast_forward_24"
            android:layout_toEndOf="@id/back_btn"
            android:layout_centerVertical="true"
            android:layout_marginStart="10dp"
            app:tint="@color/colorAccent" />

        <TextView
            android:id="@+id/nowplaing"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="Now Playing"
            android:textColor="@color/colorAccent"
            android:textSize="18sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/sleep_timer_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_timer"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            app:tint="@color/colorAccent" />


        <ImageView
            android:id="@+id/lyrics_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/ic_lyrics"
            android:layout_toStartOf="@id/sleep_timer_btn"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"
            app:tint="@color/colorAccent"
            android:contentDescription="@string/lyrics_button"/>

        <ImageView
            android:id="@+id/favorite_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:src="@drawable/baseline_favorite_24"
            android:layout_toStartOf="@id/lyrics_btn"
            android:layout_centerVertical="true"
            android:layout_marginEnd="15dp"/>

        <ImageView
            android:id="@+id/playlist_btn"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginEnd="177dp"
            android:layout_toStartOf="@id/favorite_btn"
            android:src="@drawable/ic_playlist_add"
            android:layout_centerVertical="true"
            app:tint="@color/colorAccent" />



    </RelativeLayout>
    <ImageView
        android:id="@+id/cover_art"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_below="@id/layout_top_btn"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="50dp"
        android:scaleType="centerCrop"
        android:src="@drawable/musicicon"
        android:contentDescription="@string/album_art" />

    <RelativeLayout
        android:id="@+id/bottom_controls_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="40dp">

        <LinearLayout
            android:id="@+id/seek_bar_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="20dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/durationPlayed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/colorAccent"
                android:textSize="14sp" />

            <SeekBar
                android:id="@+id/seekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"/>

            <TextView
                android:id="@+id/durationTotal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0:00"
                android:textColor="@color/colorAccent"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/seek_bar_layout"
            android:gravity="center"
            android:orientation="horizontal">
            <ImageView
                android:id="@+id/id_shuffle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_shuffle_off"
                app:tint="@color/colorAccent" />

            <ImageView
                android:id="@+id/id_prev"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginStart="20dp"
                android:src="@drawable/ic_skip_previous"
                app:tint="@color/colorAccent"/>

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/play_pause"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginEnd="20dp"
                android:clickable="true"
                android:focusable="true"
                android:src="@drawable/ic_play"
                app:backgroundTint="@color/colorPrimary"
                app:tint="@android:color/white"/>

            <ImageView
                android:id="@+id/id_next"
                android:layout_width="60dp"
                android:layout_height="60dp"
                android:layout_marginEnd="20dp"
                android:src="@drawable/ic_skip_next"
                app:tint="@color/colorAccent"/>

            <ImageView
                android:id="@+id/id_repeat"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_repeat_off"
                app:tint="@color/colorAccent" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/song_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cover_art"
        android:layout_above="@id/bottom_controls_container">

        <LinearLayout
            android:id="@+id/text_info_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/song_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="32dp"
                android:layout_marginTop="20dp"
                android:layout_marginEnd="32dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="Song Name"
                android:textColor="@color/colorAccent"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/song_name"
                android:layout_marginStart="40dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="40dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="Artist Name"
                android:textColor="@color/colorAccent"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/song_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/song_artist"
                android:layout_marginStart="40dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="40dp"
                android:ellipsize="end"
                android:gravity="center_horizontal"
                android:maxLines="1"
                android:text="Album Name"
                android:textColor="@color/colorAccent"
                android:textSize="16sp"
                android:textStyle="italic" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/lyrics_scrollview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="20dp"
            android:padding="10dp"
            android:background="#80000000"
            android:visibility="gone"> <TextView
            android:id="@+id/lyrics_textview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:gravity="center_horizontal"
            android:lineSpacingExtra="4dp"/>
        </ScrollView>
    </RelativeLayout>
</RelativeLayout>